meta {
  name: List Identities
  type: http
  seq: 1
}

docs {
  Lists imported or known identities exposed by the daemon.
}

post {
  url: {{rpc_base}}/rpc/json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 50,
    "method": "sdk_identity_list_v2",
    "params": {}
  }
}

assert {
  res.status: eq 200
}
