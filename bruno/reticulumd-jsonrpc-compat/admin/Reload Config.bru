meta {
  name: Reload Config
  type: http
  seq: 2
}

docs {
  Exercises the legacy no-params reload path.
}

post {
  url: http://127.0.0.1:4243/rpc/json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 11,
    "method": "reload_config",
    "params": {}
  }
}

assert {
  res.status: eq 200
}
