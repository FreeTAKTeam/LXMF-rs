meta {
  name: reticulumd-jsonrpc-compat
  type: collection
}

docs {
  Curated Bruno requests for the browser-safe JSON-RPC compatibility endpoint exposed by reticulumd.

  Default target:
  - http://127.0.0.1:4243/rpc/json

  If your daemon runs elsewhere, update each request URL or use Bruno's own environment tooling.
}
