meta {
  name: Poll Events
  type: http
  seq: 1
}

docs {
  Polls the event feed from the current head.

  Expected results:
  - events plus next_cursor when new events are available
  - next_cursor only when the stream is currently empty

  A next_cursor-only response is normal and should be reused in the continue request.
}

post {
  url: {{rpc_base}}/rpc/json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 40,
    "method": "sdk_poll_events_v2",
    "params": {
      "max": 16
    }
  }
}

assert {
  res.status: eq 200
}
