meta {
  name: List Topics First Page
  type: http
  seq: 2
}

docs {
  Lists topics without a cursor. For follow-up pages, reuse next_cursor from the previous result.
}

post {
  url: {{rpc_base}}/rpc/json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 21,
    "method": "sdk_topic_list_v2",
    "params": {
      "limit": 25
    }
  }
}

assert {
  res.status: eq 200
}
