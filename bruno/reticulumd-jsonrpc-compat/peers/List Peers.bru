meta {
  name: List Peers
  type: http
  seq: 1
}

docs {
  Lists currently known peers. Use this to inspect the daemon's peer table before syncing or unpeering.
}

post {
  url: {{rpc_base}}/rpc/json
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 70,
    "method": "list_peers",
    "params": {}
  }
}

assert {
  res.status: eq 200
}
