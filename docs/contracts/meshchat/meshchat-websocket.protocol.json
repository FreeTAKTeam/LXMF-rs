    {
      "name": "audio",
      "path": "/api/v1/calls/{audio_call_link_hash}/audio",
      "defaultUrl": "ws://127.0.0.1:8000/api/v1/calls/{audio_call_link_hash}/audio",
      "handshake": {
        "method": "GET",
        "successStatus": 101,
        "preUpgradeErrors": {
          "404": {
            "message": "audio call not found"
          },
          "500": "Invalid hex or unhandled errors."
        },
        "subprotocol": null,
        "authentication": null
      },
      "frames": {
        "clientToServer": "BINARY; one opaque RNS link packet per WebSocket message",
        "serverToClient": "BINARY; one received RNS link packet per WebSocket message",
        "frontendEncoding": "Protocol Buffers proto2 AudioCallPayload, containing Codec2 data",
        "base64OnWire": false,
        "textFrames": "Ignored by the application loop.",
        "serverMaxMessageSize": "aiohttp WebSocketResponse default; not explicitly set or pinned by this repository.",
        "forwardingLimit": "RNS.Link.MDU bytes in the installed RNS version. Oversize packets and packets for inactive calls are dropped without an application reply."
      },
      "protobuf": {
        "syntax": "proto2",
        "rootMessage": "AudioCallPayload",
        "source": {
          "file": "src/frontend/public/assets/proto/audio_call.proto",
          "lines": [
            1,
            31
          ],
          "url": "https://github.com/liamcottle/reticulum-meshchat/blob/df5aea94eab7f4be1cdfef494446e9d6979aed77/src/frontend/public/assets/proto/audio_call.proto#L1-L31"
        },
        "messages": {
          "AudioCallPayload": {
            "audioData": {
              "fieldNumber": 1,
              "type": "AudioData",
              "label": "optional"
            }
          },
          "AudioData": {
            "codec2Audio": {
              "fieldNumber": 1,
              "type": "Codec2Audio",
              "label": "optional"
            }
          },
          "Codec2Audio": {
            "mode": {
              "fieldNumber": 1,
              "type": "Mode",
              "label": "required"
            },
            "encoded": {
              "fieldNumber": 2,
              "type": "bytes",
              "label": "required"
            }
          }
        },
        "enums": {
          "Mode": {
            "MODE_3200": 0,
            "MODE_2400": 1,
            "MODE_1600": 2,
            "MODE_1400": 3,
            "MODE_1300": 4,
            "MODE_1200": 5,
            "MODE_700C": 6,
            "MODE_450": 7,
            "MODE_450PWB": 8
          }
        }
      },
      "connectionBehaviour": [
        "Join an existing call obtained through REST. The handler only checks existence, not is_active, before upgrading.",
        "Call hangup closes its audio socket with code 1001. Closing/leaving the audio socket is not an explicit REST hangup.",
        "The backend forwards bytes without parsing Protocol Buffers. The supplied frontend encodes/decodes AudioCallPayload.",
        "The source re-registers its audio listener on socket exit instead of unregistering it; this is a resource-management defect, not a desired wire requirement."
      ],
