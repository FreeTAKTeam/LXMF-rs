      }
    ]
  },
  "nomadnetCorrelation": {
    "key": [
      "destination_hash",
      "original file_path or page_path"
    ],
    "requestId": false,
    "parallelSamePathRequests": "Ambiguous; no independent request identifier exists.",
    "destinationHashNormalization": "Responses serialize destination_hash.hex(), hence lowercase.",
    "pageVariables": "Text after first backtick is split on | and then =, with var_ prefix. The frontend field_data object is separately mapped using field_ prefixes. Responses echo the original complete page_path.",
    "timeouts": "Path lookup and link setup default to 15 s each; these are not exposed as fields in control commands. Transfer timeout is delegated to RNS.",
    "progressScale": "0..1, not 0..100.",
    "source": [
      {
        "file": "meshchat.py",
        "lines": [
          2179,
          2203
        ],
        "url": "https://github.com/liamcottle/reticulum-meshchat/blob/df5aea94eab7f4be1cdfef494446e9d6979aed77/meshchat.py#L2179-L2203"
