  "stateAndDeliverySemantics": {
    "messageKey": "hash",
    "liveShape": "No id/created_at/updated_at. Used for created/state events and send HTTP response.",
    "storedShape": "Includes id/created_at/updated_at. Used for incoming delivery events and history.",
    "progressPollingIntervalMs": 1000,
    "stopProgressLoopWhen": [
      "state=delivered",
      "state=failed",
      "state=rejected",
      "state=cancelled",
      "state=sent AND method=propagated"
    ],
    "propagatedSentMeaning": "Sent to propagation node, not a proven final-recipient delivery.",
    "duplicateUpdatesPossible": true,
    "deletionEventScope": "Only automatic failed-message resend cleanup. REST deletes do not broadcast.",
    "noEventsFor": [
      "favourite changes",
      "custom display name changes",
      "mark-as-read",
      "propagation progress",
      "interface stats",
      "call-list state changes other than incoming call notification"
    ],
    "source": [
      {
        "file": "meshchat.py",
        "lines": [
          3011,
          3039
        ],
        "url": "https://github.com/liamcottle/reticulum-meshchat/blob/df5aea94eab7f4be1cdfef494446e9d6979aed77/meshchat.py#L3011-L3039"
      },
