    {
      "name": "control",
      "path": "/ws",
      "defaultUrl": "ws://127.0.0.1:8000/ws",
      "handshake": {
        "method": "GET",
        "successStatus": 101,
        "subprotocol": null,
        "authentication": null,
        "customHeaders": null,
        "explicitOriginValidation": false
      },
      "frames": {
        "clientToServer": "UTF-8 JSON in WebSocket TEXT frames",
        "serverToClient": "UTF-8 JSON in WebSocket TEXT frames",
        "maxClientMessageBytes": 52428800,
        "binaryClientFrames": "Ignored by the application loop.",
        "serverMessageLimit": "No explicit application-level outgoing limit."
      },
      "schemas": {
        "clientToServer": "meshchat-websocket.schema.json#/$defs/ClientMessage",
        "serverToClient": "meshchat-websocket.schema.json#/$defs/ServerMessage"
      },
      "connectionBehaviour": [
        "After registering a new socket, broadcast a full config event to ALL control sockets. Concurrent events can interleave; do not assume a globally exclusive first frame.",
        "No subscription step, event sequence number, request ID, acknowledgement envelope, durable queue or replay cursor exists.",
        "Frontend sends JSON {\"type\":\"ping\"} every 30000 ms and reconnects 1000 ms after close. It does not buffer sends while disconnected. These timings are frontend policy, not server requirements.",
        "Malformed JSON, missing keys and handler exceptions are logged and ignored. There is no generic error event. Unknown type values are logged; no reply is sent.",
        "On application shutdown, registered control sockets are closed using code 1001 (GOING_AWAY).",
        "Network messages and local event broadcasts may race with REST responses. Re-fetch history/config/state to recover after reconnect."
      ],
